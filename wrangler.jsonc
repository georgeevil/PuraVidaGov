{
  // Cloudflare Pages project for the STATIC target only: the public pages (Por qué, Marco legal,
  // Cómo funciona) with no backend. See docs/DEPLOY.md §1.
  //
  //   npm run build:static
  //   npx wrangler pages deploy apps/web/dist-static --project-name sindarvueltas
