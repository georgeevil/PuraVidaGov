{
  // The INTERACTIVE portal, deployed as a Cloudflare Container behind a Worker.
  // The static public site is a separate Pages project — see the root wrangler.jsonc.
  //
  //   npx wrangler deploy -c infra/cloudflare/wrangler.jsonc
  //
  // Cost note: `lite` is 256 MiB / 2 GB disk. The Workers Paid plan includes 25 GiB-hours of memory
  // and 200 GB-hours of disk a month, so this instance can stay awake ~100 hours a month before
  // anything is billed beyond the $5. It sleeps after 10 minutes idle and never scales past one
  // instance, so the ceiling is predictable. Measured footprint under a full 13-trámite journey: 79 MiB.
  "$schema": "https://developers.cloudflare.com/schema/wrangler.json",
  "name": "sindarvueltas-portal",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "PortalContainer",
      "image": "../../infra/Dockerfile.allinone",
      "image_build_context": "../..",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "PortalContainer", "name": "PORTAL" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PortalContainer"] }]
}
