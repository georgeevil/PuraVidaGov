# Generic image for every Node service in the monorepo (api, bus, agencies).
# Build with: docker build -f infra/Dockerfile.service --build-arg WORKSPACE=services/bus .
FROM node:22-alpine AS base
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY services/registro-civil/package.json services/registro-civil/
COPY services/tributacion/package.json services/tributacion/
COPY services/ccss/package.json services/ccss/
COPY services/municipalidad/package.json services/municipalidad/
COPY services/bus/package.json services/bus/
COPY services/registro-nacional/package.json services/registro-nacional/
COPY services/salud/package.json services/salud/
COPY services/cfia/package.json services/cfia/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
# tsx is a devDependency at the root but is the runtime for every service, so install everything.
RUN npm ci --include=dev --ignore-scripts
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY services services
COPY apps/api apps/api

ARG WORKSPACE
ENV WORKSPACE=${WORKSPACE}
USER node
CMD ["sh", "-c", "exec npx tsx ${WORKSPACE}/src/index.ts"]
