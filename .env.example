# ---- PuraVidaGov demo configuration (all values are demo-only; nothing here is a real secret) ----

# Service-to-service authentication (simple API keys, PRD §7.3)
BUS_API_KEY=demo-bus-key            # apps/api -> bus
REGISTRO_API_KEY=demo-registro-key  # bus -> Registro Civil
TRIBUTACION_API_KEY=demo-tributacion-key
CCSS_API_KEY=demo-ccss-key
MUNICIPALIDAD_API_KEY=demo-municipalidad-key

# Session signing secret for the citizen portal (apps/api)
SESSION_SECRET=demo-session-secret-change-me

# Simulated firma digital one-time code (shown on screen; there is no SMS/email)
DEMO_OTP_CODE=123456

# Automation benefits shown after registration (PRD FR-19/FR-20)
BENEFIT_TRIPS_AVOIDED=4
BENEFIT_HOURS_SAVED=8
BENEFIT_COST_SAVED_CRC=50000

# Service URLs (defaults work for `npm run dev`; docker-compose overrides them)
BUS_URL=http://localhost:4000
REGISTRO_URL=http://localhost:4001
TRIBUTACION_URL=http://localhost:4002
CCSS_URL=http://localhost:4003
MUNICIPALIDAD_URL=http://localhost:4004
API_URL=http://localhost:3001

# Simulated agency latency in ms (makes the workflow visibly step through)
AGENCY_LATENCY_MS=400
